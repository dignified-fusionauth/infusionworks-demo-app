# FusionWorks environment configuration.
# Copy this file to .env.local and fill in the values. Placeholder values are
# enough to compile / type-check / `next build`; real values are only needed to
# actually sign in against a running FusionAuth instance.

# --- FusionAuth instance -----------------------------------------------------

# Base URL of your FusionAuth instance (no trailing slash needed).
FUSIONAUTH_URL=http://localhost:9011

# The FusionWorks Application's OAuth credentials (FusionAuth admin ->
# Applications -> your app -> OAuth). client_id is also the JWT `aud`.
FUSIONAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_CLIENT_SECRET=change-me

# A FusionAuth API key (Settings -> API Keys). Used server-side for the
# Two-Factor (step-up) and Entity Management calls. Needs permission on:
#   POST /api/two-factor/status, POST /api/two-factor/start,
#   POST /api/two-factor/send,  POST /api/two-factor/login,
#   POST /api/entity/grant/search  (Entity Management demo; paid plan)
FUSIONAUTH_API_KEY=change-me

# Optional: pin a specific tenant. Leave unset to use the instance default
# tenant. When set, it's added to authorize URLs and the FusionAuthClient.
# FUSIONAUTH_TENANT_ID=

# --- App ---------------------------------------------------------------------

# Public base URL of THIS app. Used to build the OAuth redirect_uri
# (<APP_BASE_URL>/api/auth/callback) and same-origin redirect guards.
APP_BASE_URL=http://localhost:3000

# Secret used to derive the AES key that encrypts the session cookie (jose
# EncryptJWT, dir + A256GCM). Any length works — it's SHA-256'd to 32 bytes.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# --- Roles -------------------------------------------------------------------

# The Application Role name that unlocks the /admin page. Defaults to "admin"
# if unset — set it to match whatever your FusionAuth application calls it.
# FUSIONWORKS_ADMIN_ROLE=admin

# --- Per-company Identity Provider UUIDs (B2B2E enterprise SSO) ---------------
# Each demo company on the landing page deep-links straight to its own IdP via
# FusionAuth's idp_hint. The value is the Identity Provider's UUID, found in the
# FusionAuth admin at Settings -> Identity Providers -> (your IdP) -> the Id
# column / the "Id" field on the edit screen. A company whose var is empty
# renders disabled ("Not configured yet") instead of producing a broken URL.
FUSIONAUTH_IDP_ID_NORTHWIND=
FUSIONAUTH_IDP_ID_VERTEX=
FUSIONAUTH_IDP_ID_MERIDIAN=

# Optional: exact URL of FusionAuth's self-service Tenant Manager, linked from
# the /admin page. Defaults to FUSIONAUTH_URL if unset.
# FUSIONAUTH_TENANT_MANAGER_URL=
